{%- comment -%}
  Fixed set of payment icons, same as the footer and the Essential Cart Drawer:
  Amex, Apple Pay, Google Pay, Maestro, Mastercard, Shop Pay, Visa.
  The SVGs live in Settings > Files as fennholt-payment-<name>.svg.

  Usage: {% render 'payment-icons-custom' %}
{%- endcomment -%}

{%- assign payment_icons = 'american-express:American Express,apple-pay:Apple Pay,google-pay:Google Pay,maestro:Maestro,mastercard:Mastercard,shop-pay:Shop Pay,visa:Visa' | split: ',' -%}

<div class="payment-icons-custom">
  <ul class="payment-icons-custom__list" role="list" aria-label="{{ 'blocks.payment_methods' | t }}">
    {%- for icon in payment_icons -%}
      {%- assign icon_parts = icon | split: ':' -%}
      <li class="payment-icons-custom__item">
        <img
          src="{{ 'fennholt-payment-' | append: icon_parts[0] | append: '.svg' | file_url }}"
          alt="{{ icon_parts[1] }}"
          width="35"
          height="24"
          loading="lazy"
        >
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .payment-icons-custom {
    width: 100%;
  }

  .payment-icons-custom__list {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .payment-icons-custom__item {
    display: flex;
    align-items: center;
  }

  .payment-icons-custom__item img {
    display: block;
    width: auto;
    height: 24px;
  }
{% endstylesheet %}
