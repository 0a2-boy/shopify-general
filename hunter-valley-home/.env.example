# Copy to .env (repo root or hunter-valley-home/) - never commit the real file.
# Store subdomain: "your-store" or "your-store.myshopify.com"
SHOPIFY_STORE=
# Admin API access token (custom app, scope: read_products). Starts with shpat_
SHOPIFY_ADMIN_TOKEN=
# Optional, defaults to 2026-07
# SHOPIFY_API_VERSION=2026-07
